
:root {
  --bg: #0b1020;
  --card: #131b30;
  --text: #f4f6ff;
  --muted: #a8b0c5;
  --accent: #a78bfa;
  --accent2: #60a5fa;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  font-family: 'Poppins', sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(11, 16, 32, 0.95);
  border-bottom: 1px solid #252d45;
  backdrop-filter: blur(12px);
}

.navbar {
  max-width: 1100px;
  margin: auto;
  padding: 18px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 1.4rem;
  font-weight: 700;
}

.logo span {
  color: var(--accent);
}

.nav-links {
  display: flex;
  gap: 26px;
  list-style: none;
}

.nav-links a {
  color: var(--muted);
  transition: color 0.3s;
}

.nav-links a:hover {
  color: var(--accent);
}

.menu-toggle {
  display: none;
  background: transparent;
  color: white;
  border: 0;
  font-size: 1.7rem;
  cursor: pointer;
}

.hero {
  min-height: 85vh;
  max-width: 1100px;
  margin: auto;
  padding: 80px 24px;
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  align-items: center;
  gap: 50px;
}

.intro, .section-label {
  color: var(--accent);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 3px;
}

.hero h1 {
  font-size: clamp(2.7rem, 6vw, 4.5rem);
  line-height: 1.2;
  margin: 14px 0;
}

.hero h2 {
  font-size: 1.3rem;
  color: var(--accent2);
  font-weight: 500;
}

.description {
  color: var(--muted);
  max-width: 550px;
  margin: 20px 0 30px;
}

.hero-buttons, .contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.btn {
  display: inline-block;
  padding: 11px 22px;
  border-radius: 9px;
  font-weight: 500;
  transition: transform 0.3s, background 0.3s;
}

.btn:hover {
  transform: translateY(-3px);
}

.primary {
  background: linear-gradient(120deg, #8b5cf6, #6366f1);
  color: white;
}

.secondary {
  border: 1px solid #4b5572;
  color: var(--text);
}

.secondary:hover {
  background: #202a44;
}

.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  color: var(--muted);
}

.profile-circle {
  width: 260px;
  height: 260px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #8b5cf6, #2563eb);
  border: 7px solid #202a44;
  box-shadow: 0 0 70px rgba(139, 92, 246, 0.2);
  font-size: 4rem;
  font-weight: 700;
}

.section {
  max-width: 1100px;
  margin: auto;
  padding: 85px 24px;
  text-align: center;
}

.section h2 {
  font-size: 2.2rem;
  margin: 8px 0 30px;
}

.about-card {
  max-width: 800px;
  margin: auto;
  padding: 30px;
  background: var(--card);
  border: 1px solid #27314b;
  border-radius: 16px;
  color: var(--muted);
  text-align: left;
}

.about-card p + p {
  margin-top: 15px;
}

.about-card strong {
  color: var(--text);
}

.skills-grid, .projects-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  text-align: left;
}

.skill-card, .project-card {
  background: var(--card);
  padding: 24px;
  border: 1px solid #27314b;
  border-radius: 15px;
  transition: transform 0.3s, border-color 0.3s;
}

.skill-card:hover, .project-card:hover {
  transform: translateY(-5px);
  border-color: var(--accent);
}

.skill-card span {
  font-size: 2rem;
}

.skill-card h3, .project-card h3 {
  margin: 10px 0;
}

.skill-card p, .project-card p {
  font-size: 0.9rem;
  color: var(--muted);
}

.projects-grid {
  grid-template-columns: repeat(3, 1fr);
}

.project-icon {
  font-size: 2.3rem;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin: 18px 0;
}

.tags span {
  background: #252142;
  color: #c4b5fd;
  padding: 4px 9px;
  border-radius: 5px;
  font-size: 0.72rem;
}

.project-card > a {
  display: inline-block;
  margin-top: 5px;
  color: var(--accent);
  font-weight: 500;
}

.contact-text {
  color: var(--muted);
  margin-bottom: 25px;
}

.contact-links {
  justify-content: center;
}

footer {
  text-align: center;
  padding: 25px 15px;
  border-top: 1px solid #252d45;
  color: var(--muted);
  font-size: 0.85rem;
}

@media (max-width: 800px) {
  .hero {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 40px;
  }

  .description {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons {
    justify-content: center;
  }

  .profile {
    grid-row: 1;
  }

  .profile-circle {
    width: 190px;
    height: 190px;
  }

  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .projects-grid {
    grid-template-columns: 1fr;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 65px;
    left: 0;
    right: 0;
    padding: 20px;
    background: #11182b;
    flex-direction: column;
    gap: 14px;
  }

  .nav-links.open {
    display: flex;
  }

  .menu-toggle {
    display: block;
  }
}

@media (max-width: 400px) {
  .skills-grid {
    grid-template-columns: 1fr;
  }

  .section h2 {
    font-size: 1.8rem;
  }
}
